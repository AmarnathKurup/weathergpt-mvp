# ---- LLM Provider (Groq - free tier, OpenAI-compatible) ----
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# ---- Weather Providers ----
# Open-Meteo needs no API key (used as primary provider for current weather, forecast, and geocoding)
# OpenWeather is optional - only used if a key is supplied (adds extra alert detail)
OPENWEATHER_API_KEY=

# ---- App Config ----
APP_ENV=development
CORS_ORIGINS=http://localhost:3000
CACHE_TTL_SECONDS=600
