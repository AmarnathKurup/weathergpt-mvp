# ==============================================================================
# WeatherGPT Environment Configuration & API Key Acquisition Guide
# ==============================================================================
# All keys have safe fallback adapters built into the WeatherGPT backend.
# The application will function fully for evaluation even if commercial/external 
# API keys are omitted (using free Open-Meteo, IMD public endpoints, local rule engine,
# and built-in offline language translation tables).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API GATEWAY & SERVER SETTINGS
# ------------------------------------------------------------------------------
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["*"]

# ------------------------------------------------------------------------------
# 2. WEATHER DATA PROVIDERS
# ------------------------------------------------------------------------------
# PRIMARY METEOROLOGICAL SOURCE (India Meteorological Department)
# Official Portal: https://mausam.imd.gov.in / https://api.imd.gov.in
# How to get IMD API Key:
#   1. Visit the official IMD API management gateway or Mausam Portal.
#   2. Register for public/academic API access (District Warnings, City Forecasts, AWS).
#   3. If key is empty, WeatherGPT uses IMD public endpoints and Open-Meteo NWP fallback.
IMD_API_KEY=
IMD_BASE_URL=https://mausam.imd.gov.in/api

# SECONDARY / NWP METEOROLOGICAL SOURCE (Open-Meteo)
# Portal: https://open-meteo.com
# Open-Meteo requires NO API Key for non-commercial usage (30+ NWP models including ECMWF, GFS, DWD, ICON).
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# ------------------------------------------------------------------------------
# 3. AI & LLM PROVIDER CONFIGURATION
# ------------------------------------------------------------------------------
# Options: "local" (zero-cost rule/template generator), "gemini", "openai", "ollama"
DEFAULT_LLM_PROVIDER=local

# GOOGLE GEMINI API KEY
# How to get Gemini API Key:
#   1. Go to Google AI Studio: https://aistudio.google.com/
#   2. Sign in with your Google account.
#   3. Click "Get API Key" -> "Create API Key in new project".
#   4. Paste the key below.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OPENAI API KEY (Optional)
# How to get OpenAI API Key:
#   1. Go to https://platform.openai.com/account/api-keys
#   2. Create a secret key and paste below.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# OLLAMA LOCAL AI MODEL (Optional zero-cost self-hosted LLM)
# How to setup Ollama:
#   1. Download Ollama from https://ollama.com
#   2. Run `ollama run llama3` or `ollama run qwen2.5`
#   3. Default endpoint below will be automatically reachable.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ------------------------------------------------------------------------------
# 4. BHASHINI MULTILINGUAL & VOICE API
# ------------------------------------------------------------------------------
# Official Portal: https://bhashini.gov.in / https://dhruva-api.bhashini.gov.in
# How to get BHASHINI API Credentials:
#   1. Register on the official Anuvaad / Bhashini Portal (https://bhashini.gov.in/ulca/user/register).
#   2. Request API Access under ULCA / Dev Portal for NMT (Translation), ASR (Speech-to-Text), and TTS (Text-to-Speech).
#   3. Obtain your User ID, API Key, and Pipeline ID from the dashboard.
#   4. If credentials are left blank, WeatherGPT uses its built-in offline 22-language mapper.
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=
BHASHINI_BASE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline

# ------------------------------------------------------------------------------
# 5. DATA & RESOURCE PATHS
# ------------------------------------------------------------------------------
# Official India Post Pincode directory dataset is automatically loaded from:
PINCODE_DATA_PATH=data/pincode/pincode.csv
